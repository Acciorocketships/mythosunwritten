extends SceneTree
const OUT="res://docs/qa/2026-09-19-manual/122-bank-attachments"
const ROCKS=preload("res://scripts/terrain/field/CliffRockDressing.gd")
func _init()->void:run.call_deferred()
func run()->void:
 ROCKS.prepare()
 var hydraulic:=TerrainWorldTuning.make_water(2697992464)
 var fields:=WorldFieldBlockCache.new(TerrainWorldTuning.make_heightfield(2697992464,hydraulic),hydraulic,26,0,8)
 var region:=fields.region(Vector2i(-3,1))
 var cliffs:=CliffDressing.compute(region,-25,7,10)
 var neighbors:=ROCKS.formations(cliffs.wall,2697992464,region)
 neighbors.append_array(ROCKS.CORNERS.formations(cliffs.outer_wall,2697992464,region))
 neighbors.append_array(ROCKS.CORNERS.formations(cliffs.inner_wall,2697992464,region,null,true))
 ROCKS.INNER_CONNECTIONS.apply(neighbors,region)
 FileAccess.open(OUT.path_join("sources.bin"),FileAccess.WRITE).store_var(neighbors)
 print("BANK_SOURCES ",neighbors.size())
 var plants:=ROCKS.plants(neighbors,region,2697992464,null,null,neighbors)
 FileAccess.open(OUT.path_join("source-plants.bin"),FileAccess.WRITE).store_var(plants)
 print("BANK_PLANTS ",plants.size())
 quit()
