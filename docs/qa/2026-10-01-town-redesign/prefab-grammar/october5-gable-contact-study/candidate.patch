+## A gable closes its wall plane. A neighbouring eave must meet that closure
+## across the panel's thickness: clipping against its rising slope otherwise
+## removes the outer plaster above the contact line, exposing the panel back.
+## Keep footprint limits, but carry the attic's slope height at this wall
+## plane through the thickness of the gable. Roof skins still use full 3D cuts.
+static func _gable_section_cutter(volume: Dictionary, at: Vector3, axis: int) -> Dictionary:
+	var result := volume.duplicate()
+	var planes: Array[Plane] = []
+	var component := 0 if axis == 0 else 2
+	for plane: Plane in volume.planes:
+		var normal := plane.normal
+		if normal.y > EPS and absf(normal[component]) > EPS:
+			var distance := plane.d - normal[component] * at[component]
+			normal[component] = 0.0
+			planes.append(Plane(normal.normalized(), distance / normal.length()))
+		else:
+			planes.append(plane)
+	result.planes = planes
+	return result
 
 
