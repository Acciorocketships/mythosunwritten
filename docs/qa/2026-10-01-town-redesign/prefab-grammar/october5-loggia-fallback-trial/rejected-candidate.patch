+func test_door_on_preferred_bay_does_not_discard_a_clear_supported_recess() -> void:
+	var mass := BuildingMass.new()
+	mass.seed = 31
+	var original := BuildingMass.rect_cells(Rect2i(0,0,6,2))
+	for band in [0,2,4]: mass.add_storey(band,original.duplicate(),BuildingMass.MATERIAL_TIMBER)
+	mass.storeys[1].openings[Vector3i(2,0,3)] = BuildingMass.OPENING_DOOR
+	preload("res://scripts/terrain/features/villages/kit/KitLoggias.gd").recess(
+		mass,func(cell:Vector2i,_band:int)->bool:return cell.y>=0,Callable())
+	assert_true(mass.storeys[1].get("loggia",false),"A complete two-bay recess fits beside the doorway")
+	assert_true(mass.storeys[1].cells.has(Vector2i(2,0)),"The original doorway room stays intact")
+	assert_eq(mass.storeys[0].cells,original)
+	assert_eq(mass.storeys[2].cells,original,"The whole upper room covers the recessed balcony")
+
+func test_fallback_recess_cannot_remove_a_carried_balcony_bearing() -> void:
+	var mass := BuildingMass.new()
+	mass.seed = 31
+	var original := BuildingMass.rect_cells(Rect2i(0,0,6,2))
+	for band in [0,2,4]: mass.add_storey(band,original.duplicate(),BuildingMass.MATERIAL_TIMBER)
+	preload("res://scripts/terrain/features/villages/kit/KitLoggias.gd").recess(
+		mass,func(cell:Vector2i,_band:int)->bool:return cell.y>=0,Callable(),Callable(),
+		func(cell:Vector2i,band:int)->bool:return cell.y==0 and band==2)
+	assert_eq(mass.storeys[1].cells,original,"Every candidate on this front carries a measured bracket contact")
+	assert_false(mass.storeys[1].get("loggia",false))
