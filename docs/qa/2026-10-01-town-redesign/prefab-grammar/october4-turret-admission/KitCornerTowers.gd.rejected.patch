+static func _foot_supported(pose: Transform3D, kit: BuildingKit,
+		catalog: EnvironmentCatalog, bearing: Callable) -> bool:
+	if not bearing.is_valid(): return false
+	var foot: AABB = pose * catalog.descriptor(&"pure_village.roof_turret.middle").measured_aabb
+	foot.size.y = 0.01
+	var band := roundi(pose.origin.y / kit.band_height())
+	for cell: Vector3i in TOWER._cells(foot, kit):
+		if not bool(bearing.call(Vector2i(cell.x,cell.z),band)): return false
+	return true
