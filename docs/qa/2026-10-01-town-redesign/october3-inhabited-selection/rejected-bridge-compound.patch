+## The structural planner already builds a two-ended inhabited compound.
+## Give its three joined room bodies one architectural identity; do not
+## change any room, floor, bearing, doorway or public passage to obtain it.
+static func merge_bridge_houses(houses: Dictionary, spatial: WarrenSpatialPlan) -> Dictionary:
+	var out := houses.duplicate()
+	var room_house := {}
+	var bridge_rooms := {}
+	for building: WarrenBuildingVolume in spatial.buildings:
+		var id := house_id_for(building.stable_id)
+		for room: WarrenRoomStamp in building.room_records:
+			var host := StringName(room.audit.get("back_room_parcel_id", &""))
+			if not host.is_empty():
+				id = StringName("spatial.%s" % host)
+		for room: WarrenRoomStamp in building.room_records:
+			room_house[room.stable_id] = id
+			if room.audit.get("bridge_support_room_ids", []).size() == 2 \
+					and not bool(room.audit.get("bridge_is_bracketed_jetty", false)):
+				bridge_rooms[room.stable_id] = room
+	# A shared endpoint can join only one compound. Resolve this by stable
+	# textual IDs, independently of volume insertion / StringName intern order.
+	for room_id: StringName in sorted_ids(bridge_rooms.keys()):
+		var room: WarrenRoomStamp = bridge_rooms[room_id]
+		var group: Array = [room_house[room_id]]
+		for support: StringName in room.audit.bridge_support_room_ids:
+			if room_house.has(support) and not group.has(room_house[support]):
+				group.append(room_house[support])
+		if group.size() != 3:
+			continue
+		var complete := true
+		var footprint := {}
+		var phases := {}
+		for id: StringName in group:
+			if not out.has(id):
+				complete = false
+				break
+			for floor: int in out[id].storeys:
+				phases[posmod(floor, 2)] = true
+			for cell: Vector3i in out[id].cells:
+				footprint[Vector2i(cell.x, cell.z)] = true
+		if not complete or phases.size() != 1:
+			continue
+		var box := BuildingDesigner._bounds(footprint)
+		if footprint.size() > MERGE_MAX_CELLS or maxi(box.size.x, box.size.y) > MERGE_MAX_SPAN:
+			continue
+		group = sorted_ids(group)
+		var merged := _merge_house_records(out, group)
+		merged["bridge_compound"] = true
+		for id: StringName in group:
+			out.erase(id)
+		out[group[0]] = merged
+	return out
