+static func _release_unused_tunnel_piers(grid: WarrenSpatialGrid,
+		volume: WarrenVolumePlan, buildings: Array[WarrenBuildingVolume]) -> Dictionary:
+	## Shoulder recovery is conditional on an inhabited bore. If construction
+	## declines its cover, return its extra stone to the prior shoulder height.
+	## A shared successful cover, room, or walked surface keeps its bearing.
+	var source := volume.mass_context.get(&"maze_source_plan") as WarrenMazeSourcePlan
+	var released: Dictionary = {}
+	if source == null:
+		return {"failed": false, "cells": released}
+	var rooms := building_private_cells(buildings)
+	var needed: Dictionary = {}
+	var prior: Dictionary = {}
+	for plot: Dictionary in source.plots:
+		if StringName(plot["kind"]) != WarrenMazeSourcePlan.PLOT_OVER:
+			continue
+		var whole := true
+		for column: Vector2i in plot["cells"]:
+			for fine: Vector3i in _fine_square(Vector3i(column.x, int(plot["floor"]), column.y)):
+				if not rooms.has(fine): whole = false
+		if whole:
+			for jamb: Vector2i in plot.get("jambs", []): needed[jamb] = true
+		var restored := plot.get("restored_jamb_floors", {}) as Dictionary
+		for jamb: Vector2i in restored:
+			prior[jamb] = mini(int(prior.get(jamb, restored[jamb])), int(restored[jamb]))
+	var cells: Array[Vector3i] = []
+	for jamb: Vector2i in prior:
+		if needed.has(jamb): continue
+		var candidates: Array[Vector3i] = []
+		var occupied := false
+		for band in range(int(prior[jamb]), grid.minimum.y + grid.size.y):
+			for fine: Vector3i in _fine_square(Vector3i(jamb.x, band, jamb.y)):
+				if not grid.contains(fine): continue
+				var use := grid.use_at(fine)
+				if use == WarrenSpatialGrid.Use.PRIVATE_VOLUME or int(
+						grid.face_claim(fine, Vector3i.DOWN).get("kind", -1)) in [
+						WarrenSpatialGrid.FaceKind.PUBLIC_FLOOR,
+						WarrenSpatialGrid.FaceKind.GARDEN_FLOOR]:
+					occupied = true
+				candidates.append(fine)
+		if occupied: continue
+		for fine: Vector3i in candidates:
+			released[fine] = true
+			if grid.use_at(fine) == WarrenSpatialGrid.Use.STRUCTURAL_VOLUME \
+					and grid.owner_name_at(fine) == MAZE_STONE_FEATURE_ID:
+				cells.append(fine)
+	if not cells.is_empty():
+		var release := grid.begin_transaction(MAZE_STONE_FEATURE_ID)
+		if not release.release(cells, MAZE_STONE_FEATURE_ID) or not release.commit():
+			last_failure = "could not release unused tunnel piers: %s" % release.last_rejection
+			return {"failed": true, "cells": {}}
+	return {"failed": false, "cells": released}
 
 
