[sub_resource type="Resource" id="clearing_lobe_bias"]
script = ExtResource("2")
name = &"clearing_lobe_bias"
kind = 1
at_small = 0.0
at_large = 0.0
spread = 0.0
clamp_min = 0.0
clamp_max = 4.0
notes = "Town taste knobs (Oct 7) task 1: a grown clearing is kept with probability max(0.05, (mean lobe depth of its cells / deepest depth a full clearing could reach)^bias), rolled on its own stream; lobe depth = massif layer over ground averaged over a 3-column diamond, normalised (WarrenCourtClearings.lobe_depth). Pulls courtyards into the town field's Gaussian lobes where houses stand. Rejections have their own attempt budget and the last attempts accept regardless, so the count is not under-filled. 0 = off (today)."

[sub_resource type="Resource" id="clearing_enclosure_bias"]
script = ExtResource("2")
name = &"clearing_enclosure_bias"
kind = 1
at_small = 0.0
at_large = 0.0
spread = 0.0
clamp_min = 0.0
clamp_max = 4.0
notes = "Town taste knobs (Oct 7) task 1: a grown clearing is kept with probability max(0.05, ((1 + sides houses can front) / 5)^bias), rolled on its own stream; rejections have their own attempt budget and the last attempts accept regardless. 0 = always kept (today)."

[sub_resource type="Resource" id="plaza_ring_chance"]
script = ExtResource("2")
name = &"plaza_ring_chance"
kind = 0
at_small = 1.0
at_large = 1.0
spread = 0.0
clamp_min = 0.0
clamp_max = 1.0
notes = "Town taste knobs (Oct 7) task 2: chance the primary green plaza (plaza.00) keeps its one-cell walking ring round the lawn, rolled per plot id. Without a ring the lawn reaches every court edge that faces built mass; walk is kept only on edges facing a street, open air or a drop (those keep their guards), on every door/entrance landing, and on 1-cell strips joining them (WarrenVolumetricSolver._ringless_court_walk). 1 = always ringed (today)."

[sub_resource type="Resource" id="clearing_ring_chance"]
script = ExtResource("2")
name = &"clearing_ring_chance"
kind = 0
at_small = 1.0
at_large = 1.0
spread = 0.0
clamp_min = 0.0
clamp_max = 1.0
notes = "Town taste knobs (Oct 7) task 2: chance a green clearing court (clearing.NN, purpose green) keeps its walking ring, rolled per plot id; ringless greens as for plaza_ring_chance. 1 = always ringed (today)."

[sub_resource type="Resource" id="clearing_deco_density"]
script = ExtResource("2")
name = &"clearing_deco_density"
kind = 1
at_small = 0.0
at_large = 0.0
spread = 0.0
clamp_min = 0.0
clamp_max = 1.0
notes = "Town taste knobs (Oct 7) task 3: how fully a courtyard clearing (clearing.NN) is furnished for its purpose -- each clearing places up to round(density x capacity) prop groups (capacity = deco cells / 6, clamped 2..6) on its non-walk cells (green: the lawn island; paved/market/workyard: the court minus its kept walk of landings, street mouths and joining strips). Green: benches, planters, plants, a lantern post; paved: a stocked stall, crates, barrels, a bench; market: stocked stalls and goods; workyard: anvil, work table, firewood, crates. Order rolled per plot id; every piece passes the optional-dressing clearance gate and never overlaps the centre features or another piece (SettlementFabricAssembler.maze_clearing_decor). 0 = bare (today)."

[sub_resource type="Resource" id="well_scale"]
script = ExtResource("2")
name = &"well_scale"
kind = 1
at_small = 1.0
at_large = 1.0
spread = 0.0
clamp_min = 0.4
clamp_max = 1.25
notes = "Town taste knobs (Oct 7) task 4: size factor of a green's well (sfv.well.001 -> suntail well), applied to the placement's scale before the clearance check so a smaller well also frees room. Wells only ever stand on ground-level greens (a hard rule, not a knob: a raised green gets the next piece in its seeded rotation). 1 = the authored kit fit (today)."

[sub_resource type="Resource" id="satellite_reach_scale"]
script = ExtResource("2")
name = &"satellite_reach_scale"
kind = 1
at_small = 1.0
at_large = 1.0
spread = 0.0
clamp_min = 0.3
clamp_max = 1.5
notes = "Town taste knobs (Oct 7) task 6: multiplies how far the town field's satellite lobes stand from the town centre (radius x spread x 0.75..1.2), the gap clearings between them, and (up to 1.0) the central-green ring (1.25..MAX_GREEN_REACH x radius). Applied after the field's own draws, so no other roll moves, but the whole layout follows the lobes (shoulders, house/massif classification, terraces, streets), so a changed reach reshapes the town, not just its satellites. The central-green ring is capped at 1.0 (a wider ring would leave the discovery bound). A house lobe pushed against other mass (no clear 2-column ring) is refused as a cottage site, never the town. Below 1 pulls satellite houses and districts in toward the core. 1 = today."

[sub_resource type="Resource" id="suburb_house_count"]
script = ExtResource("2")
name = &"suburb_house_count"
kind = 2
at_small = 0.0
at_large = 0.0
spread = 0.0
clamp_min = 0.0
clamp_max = 12.0
notes = "Town taste knobs (Oct 7) task 6: up to this many small one-storey house lobes in an annulus 1.0-1.4 x radius round the town centre (a suburban band of detached cottages between the dense core and the countryside), drawn after every other lobe on this knob's own stream. Each steps outward from its drawn 1.0-1.4 radius to the first spot with a clear 2-column (Chebyshev) ring between its footprint and every other lobe's, inside the sampled box; a direction with no such spot is redrawn (4 tries), then the cottage is dropped (never the town); survivors become house sites through the ordinary house-site admission (a whole 2x2 block, a garden of 4+ columns, clear of the raised district), so steep, wet or crowded ground drops them. 0 = today."

[sub_resource type="Resource" id="lone_house_path_chance"]
script = ExtResource("2")
name = &"lone_house_path_chance"
kind = 0
at_small = 1.0
at_large = 1.0
spread = 0.0
clamp_min = 0.0
clamp_max = 1.0
notes = "Town taste knobs (Oct 7) task 6: chance a reserved cottage (house site) not already on the street network gets a painted access road, rolled per site id. When the roll fails and the cottage stands on its own ground with its whole approach over open ground at that grade, its approach is a footway (feature_kind house_site_footway): still walk for the door and the audits, but no worn-path paint (PublicRealmSurfacePlan.footway_columns). Otherwise the road is carved regardless. 1 = always a road (today)."

[resource]
script = ExtResource("1")
knobs = Array[Resource]([SubResource("clearing_count"), SubResource("clearing_block_bias"), SubResource("clearing_ground_weight"), SubResource("clearing_area"), SubResource("clearing_shape"), SubResource("clearing_extra_link_chance"), SubResource("clearing_cover"), SubResource("clearing_purpose"), SubResource("clearing_lobe_bias"), SubResource("clearing_enclosure_bias"), SubResource("plaza_ring_chance"), SubResource("clearing_ring_chance"), SubResource("clearing_deco_density"), SubResource("well_scale"), SubResource("satellite_reach_scale"), SubResource("suburb_house_count"), SubResource("lone_house_path_chance")])
